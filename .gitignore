node_modules/
.next/
.next-dev/
out/
# Anchored to the repo root. Unanchored, `build/` matched app/api/build/ — the
# route the whole two-phase pipeline runs through — and kept it out of the
# repository entirely, so a fresh clone had no working /api/build at all.
/build/
/dist/

.env
.env.local
.env*.local

*.tsbuildinfo
next-env.d.ts

.DS_Store
Thumbs.db
.vercel

# Machine-local Claude Code permissions — not shared.
.claude/settings.local.json

# Personal/marketing images that live in this folder but aren't part of the app.
# The app's only image asset is public/bch-logo.svg. Delete these two lines if
# you want them version-controlled.
Pictures/
BCH Address and phone numbers/

# local timing probes
probe-*.mjs

# built skill package - regenerate with Compress-Archive
skill/bch-cheat-sheet.zip

# Spec books staged for browser testing. Client documents must never be served
# from public/ or committed.
/public/uitest/

# Data blocks kept between runs so a failed compose does not discard the
# reading phase. Derived from client spec text — never commit.
/.block-cache/
