# Copy this file to .env.local and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5 (the current Sonnet-tier model).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Effort level for the generation call: low | medium | high | xhigh | max
# Higher = more thorough spec reading, more tokens, longer runtime. Default: high
# ANTHROPIC_EFFORT=high

# Optional, local development only. Path to a Chrome/Edge executable used for
# PDF rendering. If unset, the app auto-detects Chrome then Edge on Windows/macOS/Linux.
# On Vercel this is ignored — @sparticuz/chromium is used instead.
# LOCAL_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Sign-in (Microsoft Entra ID) -------------------------------------------
# Leave these unset for local development: the app then runs open on localhost
# and refuses to serve any other host, rather than deploying unprotected.
#
# IT provides the first three from the app registration. Single tenant: the
# issuer URL must carry the BCH tenant id, not "common" — "common" would let any
# Microsoft account anywhere sign in.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<BCH-TENANT-ID>/v2.0
# Any long random string; used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# The site's own address, so sign-in redirects come back to the right place.
NEXTAUTH_URL=https://cheatsheets.bch.local
